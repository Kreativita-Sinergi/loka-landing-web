{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loka-landing-web",
  "compatibility_date": "2026-11-18",
  "main": "./worker.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/images/share/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "995922d7c5924b73a24deb08fff3cab0"
    }
  ],
  "routes": [
    {
      "pattern": "lokakasir.id/*",
      "zone_name": "lokakasir.id"
    },
    {
      "pattern": "www.lokakasir.id/*",
      "zone_name": "lokakasir.id"
    }
  ]
}
